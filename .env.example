# Copie para .env e ajuste.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://prumo:prumo@db:5432/prumo
# Fila da IA (Celery); o docker-compose já define. Sem ela, os pedidos à IA rodam na hora.
CELERY_BROKER_URL=redis://redis:6379/0
