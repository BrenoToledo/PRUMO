# Copie para deploy/.env e ajuste. Nunca faça commit do .env.

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Nomes pelos quais o Prumo é acessado (separados por vírgula, sem espaço e sem https://).
DJANGO_ALLOWED_HOSTS=prumo.casa.lan,localhost
# Endereços HTTPS completos de onde vêm os formulários (com https://).
DJANGO_CSRF_TRUSTED_ORIGINS=https://prumo.casa.lan
DJANGO_TIME_ZONE=America/Sao_Paulo

# Banco (o docker-compose monta o DATABASE_URL a partir destes). Senha só com letras, números, - e _.
POSTGRES_USER=prumo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=prumo

# Porta do backend no host. Use 127.0.0.1:8000 se só o proxy HTTPS (Caddy ou Tailscale) acessar.
PRUMO_PORTA=8000

# Backup diário (pg_dump): horário, dias guardados e pasta no host (relativa a deploy/).
BACKUP_HORA=03:00
BACKUP_RETENCAO_DIAS=7
PRUMO_BACKUP_DIR=./backups

# Só com o perfil "https" (Caddy): domínio e emissor do certificado.
# "internal" = CA própria do Caddy (instale a raiz no celular); um e-mail = Let's Encrypt (domínio público).
PRUMO_DOMINIO=prumo.casa.lan
PRUMO_TLS=internal

# IA (opcional; sem modelo a IA fica desligada). Modelo no formato do LiteLLM; a chave nunca vai para o banco.
# IA do Prumo, ex.: anthropic/claude-haiku-5-5 (ou "falso" para demonstrar sem rede)
PRUMO_IA_MODELO=
PRUMO_IA_CHAVE=
# Minha chave de API (outro provedor ou conta), ex.: openai/gpt-4o-mini
PRUMO_IA_MODELO_PROPRIO=
PRUMO_IA_CHAVE_PROPRIA=
# Modelo local, ex.: ollama/llama3.2 com PRUMO_IA_URL_LOCAL=http://ollama:11434
PRUMO_IA_MODELO_LOCAL=
PRUMO_IA_URL_LOCAL=
# Limites por usuário: sugestões por dia e gasto por mês (dólar)
PRUMO_IA_LIMITE_DIARIO=50
PRUMO_IA_LIMITE_MENSAL_USD=2
